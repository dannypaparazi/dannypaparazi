# Get this from the Vercel dashboard (Storage -> your Postgres database, which
# runs on Neon) or by running, after `vercel link`:
#   vercel env pull .env.local
DATABASE_URL=""

# Older Vercel Postgres integrations expose these names instead — the app reads
# either, so only one set needs to be present.
# POSTGRES_URL=""
# POSTGRES_URL_NON_POOLING=""
